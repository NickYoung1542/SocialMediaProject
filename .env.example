# Copy to .env. All services below have a free tier.

# LLM: "gemini" (free key from https://aistudio.google.com/apikey) or "ollama" (local, no key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_MODEL=llama3.1:8b

# Stock footage (both free). Set at least one:
#   Pexels:  https://www.pexels.com/api/
#   Pixabay: https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# TikTok app credentials (https://developers.tiktok.com/apps/). One app can serve many accounts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
